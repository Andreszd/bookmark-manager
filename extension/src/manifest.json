{
  "manifest_version": 3,
  "name": "Bookmark Extension",
  "version": "1.0",
  "description": "A browser extension to manage bookmarks.",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["activeTab", "webNavigation", "windows", "storage", "tabs"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": ["http://localhost:4200/*"]
  },
  "host_permissions": ["http://localhost:3000/*"]
}
